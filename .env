# ShareT Frontend Environment Variables

# API Configuration
# Use relative URL so Docker deployment works from any IP/domain
VITE_API_URL=/api

# Trello API Configuration
VITE_TRELLO_API_KEY=b82d657cb6819471b76a73c60776b176
# Optional bot account for real-looking comments (see .env.docker for full instructions)
TRELLO_BOT_TOKEN=
VITE_APP_NAME=ShareT

# Feature Flags
VITE_ENABLE_EMAIL_VERIFICATION=true
VITE_ENABLE_GITHUB_INTEGRATION=true

# Analytics (optional)
VITE_ANALYTICS_ID=

# Deployment Environment
VITE_ENVIRONMENT=development
