# Optional: shared bot Trello account for real-looking comments.
# 1. Create a dedicated Trello account (e.g. a generic "ShareT" account)
# 2. Add it as a member to every board you share cards from
# 3. Go to https://trello.com/app-key while logged in AS THAT BOT ACCOUNT,
#    click "Token" (with read,write,account scope), paste it below.
# When set, ShareT renames the bot to the client's name before posting each
# comment, so it appears in Trello as from a real account — no bold prefix.
TRELLO_BOT_TOKEN=
TRELLO_CALLBACK_URL=https://nonhyperbolic-antony-unresentful.ngrok-free.dev
# ============================================================
# PUBLIC URLS (update when Cloudflare tunnel URL changes)
# ============================================================
PUBLIC_URL=https://nonhyperbolic-antony-unresentful.ngrok-free.dev
FRONTEND_URL=https://nonhyperbolic-antony-unresentful.ngrok-free.dev
CORS_ORIGIN=https://nonhyperbolic-antony-unresentful.ngrok-free.dev,http://localhost:5005

# ngrok agent authtoken — required now that ngrok runs INSIDE Docker
