# ---------------------------------------------------------------
# REQUIRED for the Trello notification bell to work at all.
#
# Trello NEVER notifies you about actions you performed yourself. While this
# is empty, ShareT posts freelancer comments with the OWNER's token, so Trello
# records them as written by the owner: no bell, and @card / @username inside
# them are discarded as self-mentions. This is the single reason the bell has
# been silent.
#
# Setup (once):
# 1. Create a SEPARATE Trello account, e.g. named "ShareT"
# 2. Add it as a member to every BOARD you share cards from
#    (ShareT then assigns it to individual cards automatically)
# 3. Log in AS THAT ACCOUNT, open https://trello.com/app-key, click "Token"
#    (read,write,account scope) and paste it below
# 4. Redeploy, then confirm the green banner in ShareT's Trello panel
#    (or GET /api/trello/notification-health)
TRELLO_BOT_TOKEN=

# The Trello username that freelancer comments mention. Without the leading @.
SHARET_TRELLO_NOTIFY_USERNAME=noodzakelijkonline

# Keep this false. If the relay ever fails, the alternative is posting as the
# owner again — which looks like it worked but silently kills the bell.
SHARET_ALLOW_OWNER_COMMENT_FALLBACK=false

# Also subscribe the owner to every shared card. Second, independent delivery
# path for the bell: it works even if the mention is missing or removed.
SHARET_AUTO_WATCH_CARDS=true
