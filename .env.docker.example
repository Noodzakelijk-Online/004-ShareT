# ============================================================
# ShareT Docker Deployment — Environment Variables
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# ============================================================

NODE_ENV=production
PORT=5005
DATA_DIR=/app/backend/data

# ============================================================
# TRELLO API
# Get your key at: https://trello.com/app-key
# ============================================================
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here
TRELLO_CALLBACK_URL=https://your-public-url.example.com

# Optional: dedicated bot Trello account for real-looking client comments.
# Create a Trello account, add it to your boards, get its token at:
# https://trello.com/app-key (click "Token" while logged in as the bot)
TRELLO_BOT_TOKEN=

# ============================================================
# PUBLIC URLS — set to your ngrok domain, VPS domain, or localhost
# ============================================================
PUBLIC_URL=https://your-public-url.example.com
FRONTEND_URL=https://your-public-url.example.com
CORS_ORIGIN=https://your-public-url.example.com,http://localhost:5005

# ============================================================
# SECURITY SECRETS — generate with: openssl rand -hex 32
# ============================================================
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_EXPIRE=30d
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_16

# ============================================================
# EMAIL (Gmail SMTP) — for password reset emails
# Use an App Password: https://myaccount.google.com/apppasswords
# ============================================================
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=ShareT <your_gmail@gmail.com>

# ============================================================
# OPTIONAL INTEGRATIONS
# ============================================================

# CouchDB cloud sync (leave empty for local-only mode)
COUCHDB_URL=
COUCHDB_AUTH=

# MongoDB (legacy — not used with PouchDB mode)
MONGODB_URI=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Tunnel ID (alternative to ngrok)
CLOUDFLARE_TUNNEL_ID=

# ============================================================
# OTHER
# ============================================================
MAINTENANCE_MODE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
ENABLE_RESOURCE_TRACKING=true
RESOURCE_PRICE_MULTIPLIER=2
