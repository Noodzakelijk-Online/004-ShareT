# ShareT Frontend - Production Build Environment Variables
# These values are baked into the frontend build at `npm run build` time.

# API base URL — relative path so the build works on ANY domain
# (Cloudflare tunnel, custom domain, localhost) without rebuild.
# Frontend is served from same origin as backend.
VITE_API_URL=/api

# Trello public API key (used by frontend Power-Up integrations)
VITE_TRELLO_API_KEY=b82d657cb6819471b76a73c60776b176

VITE_APP_NAME=ShareT

# Feature Flags
VITE_ENABLE_EMAIL_VERIFICATION=true
VITE_ENABLE_GITHUB_INTEGRATION=true

VITE_ENVIRONMENT=production
