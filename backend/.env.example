# ShareT Backend Configuration
# PouchDB Edition - no database installation required.

# Server Configuration
PORT=5005
NODE_ENV=development

# Public URL
# Use a stable HTTPS URL from Cloudflare Tunnel, ngrok static domain, VPS, Railway, Render, etc.
# Do not use a changing temporary URL for production links or Trello OAuth.
PUBLIC_URL=http://localhost:5005
FRONTEND_URL=http://localhost:5005
CORS_ORIGIN=http://localhost:5005

# Trello API Credentials (Required)
# Get these at: https://trello.com/app-key
TRELLO_API_KEY=your_api_key_here
TRELLO_API_SECRET=your_api_secret_here
TRELLO_CALLBACK_URL=http://localhost:5005/api/trello/callback

# Trello notification identity
# Recommended: create a dedicated Trello member such as "ShareT Updates Bot",
# add it to the relevant boards, and generate a token for that account.
# Freelancers do NOT need Trello accounts; ShareT posts on their behalf through this token.
TRELLO_BOT_TOKEN=
SHARET_TRELLO_NOTIFY_USERNAME=noodzakelijkonline
SHARET_ALLOW_OWNER_COMMENT_FALLBACK=true

# Optional direct email notification fallback
# This makes updates visible even if Trello's notification bell does not fire.
SHARET_NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Security Secrets (Required for Production)
# Change these in a production environment
JWT_SECRET=super_secret_jwt_key_development_only
JWT_EXPIRES_IN=7d
SESSION_SECRET=super_secret_session_key_development_only
ENCRYPTION_KEY=super_secret_32_character_encryption_key_123

# PouchDB Configuration
# Data is stored locally in ./data directory by default.
DATA_DIR=./data

# Optional: CouchDB Cloud Sync
# Uncomment and configure to enable cloud sync.
# COUCHDB_URL=https://your-couchdb-server.com
# COUCHDB_AUTH={"username":"admin","password":"password"}
