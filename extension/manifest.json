{
  "manifest_version": 3,
  "name": "ShareT - Share Trello Cards",
  "version": "1.0.0",
  "description": "Add a 'Share via ShareT' button to Trello cards for quick external sharing",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["https://trello.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShareT Configuration"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
